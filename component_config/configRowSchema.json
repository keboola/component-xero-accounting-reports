{
  "type": "object",
  "title": "Xero Report Configuration",
  "required": ["report_type"],
  "properties": {
    "report_type": {
      "type": "string",
      "title": "Report Type",
      "enum": [
        "TenNinetyNine",
        "AgedPayablesByContact",
        "AgedReceivablesByContact",
        "BalanceSheet",
        "BankSummary",
        "BASReport",
        "BudgetSummary",
        "ExecutiveSummary",
        "GSTReport",
        "ProfitAndLoss",
        "TrialBalance"
      ],
      "enumNames": [
        "1099 Report (US)",
        "Aged Payables By Contact",
        "Aged Receivables By Contact",
        "Balance Sheet",
        "Bank Summary",
        "BAS Report (Australia)",
        "Budget Summary",
        "Executive Summary",
        "GST Report (New Zealand)",
        "Profit and Loss",
        "Trial Balance"
      ],
      "description": "Select the type of report to extract",
      "propertyOrder": 1
    },
    "xero_tenant_id": {
      "type": "string",
      "title": "Xero Tenant/Organization",
      "description": "Select a specific Xero organization. Leave empty to fetch reports for ALL connected organizations.",
      "propertyOrder": 3,
      "options": {
        "async": {
          "action": "get_tenants",
          "label": "LOAD TENANTS"
        }
      }
    },
    "report_parameters": {
      "type": "array",
      "title": "Report Parameters",
      "description": "Common parameters for the selected report. You can use static and dynamic dates like 'yesterday', '3 months ago'.",
      "format": "table",
      "items": {
        "type": "object",
        "title": "Parameter",
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "string",
            "title": "Parameter Name",
            "enum": [
              "fromDate",
              "toDate",
              "date",
              "periods",
              "timeframe",
              "standardLayout",
              "paymentsOnly",
              "contactID",
              "reportYear",
              "ReportID"
            ],
            "enumNames": [
              "From Date",
              "To Date",
              "Date",
              "Periods",
              "Timeframe",
              "Standard Layout",
              "Payments Only",
              "Contact ID",
              "Report Year",
              "Report ID"
            ]
          },
          "value": {
            "title": "Value"
          }
        }
      },
      "propertyOrder": 4
    },
    "custom_parameters": {
      "type": "array",
      "title": "Custom Parameters",
      "description": "Additional parameters not listed above (e.g., trackingCategoryID, trackingOptionID)",
      "format": "table",
      "items": {
        "type": "object",
        "title": "Parameter",
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "string",
            "title": "Parameter Name"
          },
          "value": {
            "title": "Value"
          }
        }
      },
      "propertyOrder": 5
    }
  }
}
